{
    "name": "agoge-forger Python 3.12",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "postCreateCommand": "uv venv && uv pip install -e \".[dev]\"",
    "containerUser": "vscode",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/nvidia-cuda:2": {
            "cudaVersion": "12.4",
            "installCudnn": true,
            "installToolkit": true
        }
    },
    "runArgs": [
        "--gpus",
        "all"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-python.mypy-type-checker",
                "tamasfe.even-better-toml"
            ]
        }
    }
}
