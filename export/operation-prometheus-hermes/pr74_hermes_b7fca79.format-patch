+            "artifact_sha256": [
+                "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
+            ],
+            "identity": "trace-self",
+            "outcome": "pass",
+            "version": "0.0.0",
+        },
+    )
+    paths = write_scenario(
+        tmp_path,
+        [record],
+        manifest_overrides={"verifier": default_verifier(outcome="fail")},
